[
    {
        "id": "Z",
        "duration": 6,
        "type": "text",
        "text": "'z'",
        "color": "'LIGHT_GRAY'",
        "dx": "self.age * -2",
        "dy": "self.age * -2",
        "alpha": "1 - self.age / self.duration",
        "shadow": false
    },
    {
        "id": "DAMAGE_NUMBER",
        "duration": 0.5,
        "type": "text",
        "text": "'-' .. self.amount or 0",
